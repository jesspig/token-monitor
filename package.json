{
  "name": "token-monitor",
  "version": "0.1.4",
  "description": "插件化架构的跨 AI 编程 CLI 的 Token 用量监控桌面工具",
  "main": "./out/main/index.js",
  "build": {
    "appId": "com.tokenmonitor.app",
    "productName": "Token Monitor",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "resources/tray/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "resources/tray/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "resources/tray/icon.png"
    },
    "extraResources": [
      {
        "from": "resources/tray",
        "to": "tray"
      }
    ]
  },
  "author": "",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist": "electron-vite build && electron-builder",
    "dist:dir": "electron-vite build && electron-builder --dir",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.0.0",
    "better-sqlite3": "^11.7.0",
    "chokidar": "^4.0.0",
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "fzstd": "^0.1.1",
    "lucide-react": "^0.460.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.0",
    "electron-builder": "^25.0.0",
    "electron-vite": "^3.0.0",
    "postcss": "^8.4.49",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
